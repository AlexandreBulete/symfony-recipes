{
    "manifests": {
        "alexandrebulete/ddd-iam-bundle": {
            "manifest": {
                "bundles": {
                    "AlexandreBulete\\DddIamBundle\\DddIamBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  * Run the migrations: <comment>bin/console doctrine:migrations:migrate</>",
                    "  * Create the first administrator: <comment>bin/console iam:create-super-admin</>",
                    "  * Protect the back office with the <comment>backoffice.access</> permission in <comment>config/packages/security.yaml</>"
                ]
            },
            "files": {
                "config/packages/iam.yaml": {
                    "contents": [
                        "# alexandrebulete/ddd-iam-bundle: users, roles and permissions, authentication,",
                        "# audit trail and back-office screens.",
                        "#",
                        "# Everything works without touching this file; it only shows the extension",
                        "# points. Roles and their permissions are data (back office, Roles screen), not",
                        "# configuration: `super_admin` is created by the bundle's migrations.",
                        "#",
                        "# Not IAM, so not here: phone, avatar, organisation. Those belong to a",
                        "# companion aggregate in one of the project's contexts, keyed by UserId.",
                        "iam:",
                        "    # password_policy:",
                        "    #     min_length: 12",
                        "    #     require_letters: true",
                        "    #     require_digits: true",
                        "    #     require_mixed_case: false",
                        "    #     require_special_character: false",
                        "",
                        "    # audit:",
                        "    #     enabled: true      # false: no listener, no writes (the table stays)",
                        "",
                        "    # admin:",
                        "    #     enabled: true      # false: headless deployment, no Sylius screen",
                        "    #     grid_limits: [10, 25, 50]",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/iam.yaml": {
                    "contents": [
                        "# Plain controllers of the bundle (autocomplete). The back-office screens are",
                        "# Sylius resources: their routes come from #[AsResource], not from here.",
                        "iam:",
                        "    resource: '@DddIamBundle/config/routes.php'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "122f19752ff65f2893315a982a881b8779c44238"
        }
    }
}
